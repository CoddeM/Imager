<?xml version="1.0" encoding="utf-8"?>
<!--
  Imager launcher foreground: a thermal printer with a freshly printed photo strip coming out
  of its mouth. Everything sits inside the 66dp adaptive-icon safe zone (x/y 21..87) so no
  launcher mask can clip it. The background it sits on changes per weekday - see
  LauncherIconManager and the ic_launcher_bg_* gradients.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper strip. Drawn first so the printer body overlaps its top edge. -->
    <path
        android:fillColor="#F4F8FD"
        android:pathData="M36,44 L72,44 L72,76 l-3.6,4 l-3.6,-4 l-3.6,4 l-3.6,-4 l-3.6,4 l-3.6,-4 l-3.6,4 l-3.6,-4 l-3.6,4 l-3.6,-4 L36,44 Z" />

    <!-- The printed image: sun + mountain range, in thermal-ink dark. -->
    <path
        android:fillColor="#16222F"
        android:pathData="M64,53.6 a3.4,3.4 0 1 1 0,6.8 a3.4,3.4 0 1 1 0,-6.8 z" />
    <path
        android:fillColor="#16222F"
        android:pathData="M39,74 L48.5,58 L55,67 L60,60.5 L69,74 Z" />

    <!-- Printer body. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,26 h46 a5,5 0 0 1 5,5 v14 a5,5 0 0 1 -5,5 h-46 a5,5 0 0 1 -5,-5 v-14 a5,5 0 0 1 5,-5 z" />

    <!-- Control panel. -->
    <path
        android:fillColor="#16222F"
        android:pathData="M36,32 h26 a3,3 0 0 1 3,3 v1 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-1 a3,3 0 0 1 3,-3 z" />

    <!-- Ready LED. -->
    <path
        android:fillColor="#34D399"
        android:pathData="M74,32.7 a2.8,2.8 0 1 1 0,5.6 a2.8,2.8 0 1 1 0,-5.6 z" />

    <!-- Paper mouth. Sits flush with the body's bottom edge so the strip reads as emerging. -->
    <path
        android:fillColor="#16222F"
        android:pathData="M37,44 h34 a3,3 0 1 1 0,6 h-34 a3,3 0 1 1 0,-6 z" />
</vector>
